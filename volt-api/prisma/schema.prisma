generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  EXPIRED
  CANCELLED
}

enum GymStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum DoorStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  DISABLED
  MAINTENANCE
}

enum ProviderName {
  MOCK
  KISI
}

enum AccessEventResult {
  GRANTED
  DENIED
  ERROR
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  name          String
  phone         String?
  status        UserStatus   @default(ACTIVE)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  accessEvents  AccessEvent[]
  profile       Profile?
  activities    Activity[]
  posts         Post[]
  reactions     Reaction[]
  comments      Comment[]
  meetups       Meetup[]
  meetupRSVPs   MeetupAttendee[]
  convMembers   ConversationMember[]
  chatMessages  ChatMessage[]
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyTargetH       Int      @default(3)
  goal                String   @default("")
  activities          String[] @default([])
  homeGymId           String?
  privacy             Json     @default("{}")
  units               String   @default("mi")
  experience          String   @default("beginner")
  notifications       Json     @default("{}")
  onboardingCompleted Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Gym {
  id          String                    @id @default(uuid())
  name        String
  status      GymStatus                 @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  locations   GymLocation[]
  memberships Membership[]
  doors       Door[]
  connections AccessProviderConnection[]
  rules       AccessRule[]
  events      AccessEvent[]
}

model GymLocation {
  id          String                    @id @default(uuid())
  gymId       String
  gym         Gym                       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  address     String
  latitude    Float
  longitude   Float
  timezone    String                    @default("America/Chicago")
  status      LocationStatus            @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  doors       Door[]
  connections AccessProviderConnection[]
  rules       AccessRule[]
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId          String
  gym            Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  locationIds    String[]         @default([])
  status         MembershipStatus @default(ACTIVE)
  membershipType String           @default("STANDARD")
  startsAt       DateTime
  expiresAt      DateTime
  accessLevel    String           @default("FULL")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, gymId])
}

model Door {
  id                 String       @id @default(uuid())
  locationId         String
  location           GymLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  gymId              String
  gym                Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name               String
  provider           ProviderName @default(MOCK)
  providerDoorId     String       @unique
  enabled            Boolean      @default(true)
  requiresProximity  Boolean      @default(false)
  radiusMeters       Int          @default(150)
  status             DoorStatus   @default(ONLINE)
  accessHoursStart   String?
  accessHoursEnd     String?
  accessHoursDays    Int[]        @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  rules              AccessRule[]
  events             AccessEvent[]
}

model AccessProviderConnection {
  id                   String      @id @default(uuid())
  gymId                String?
  gym                  Gym?        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  locationId           String?
  location             GymLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider             ProviderName
  encryptedCredentials String
  status               String      @default("ACTIVE")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model AccessEvent {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doorId          String
  door            Door              @relation(fields: [doorId], references: [id], onDelete: Cascade)
  gymId           String
  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  action          String            @default("UNLOCK")
  result          AccessEventResult
  reason          String?
  provider        ProviderName      @default(MOCK)
  providerEventId String?
  deviceId        String?
  ip              String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([doorId, createdAt])
}

model AccessRule {
  id                String      @id @default(uuid())
  doorId            String
  door              Door        @relation(fields: [doorId], references: [id], onDelete: Cascade)
  gymId             String
  gym               Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  locationId        String?
  location          GymLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  membershipType    String?
  accessLevel       String?
  accessHoursStart  String?
  accessHoursEnd    String?
  accessHoursDays   Int[]       @default([])
  requiresProximity Boolean     @default(false)
  radiusMeters      Int         @default(150)
  enabled           Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Activity {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  title            String
  startedAt        DateTime
  durationMin      Int
  distanceKm       Float?
  calories         Float?
  elevationM       Float?
  avgPaceSecPerKm  Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, startedAt])
}

model Post {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  activityId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  reactions  Reaction[]
  comments   Comment[]

  @@index([userId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Meetup {
  id           String           @id @default(uuid())
  organizerId  String
  organizer    User             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title        String
  activityType String
  location     String
  startsAt     DateTime
  capacity     Int              @default(20)
  description  String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attendees    MeetupAttendee[]

  @@index([startsAt])
}

model MeetupAttendee {
  id        String   @id @default(uuid())
  meetupId  String
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetupId, userId])
}

model Conversation {
  id        String                @id @default(uuid())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  members   ConversationMember[]
  messages  ChatMessage[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
