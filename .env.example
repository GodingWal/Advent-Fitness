# Backend API base URL. Set automatically by `npm run dev` (LAN IP of this machine).
# Production builds MUST set an explicit https:// endpoint — there is no fallback.
# If this is missing in dev you will get: "EXPO_PUBLIC_API_URL is missing. Run npm run dev."
EXPO_PUBLIC_API_URL=http://192.168.5.2:3000

# Customer website (volt-web). Server proxy prefers VOLT_API_URL; browser
# bundle uses NEXT_PUBLIC_API_URL. Local dev default is http://localhost:3000.
VOLT_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Places API key (used in src/services/places.js)
# Prefer proxying via EXPO_PUBLIC_API_URL/places/nearby to avoid shipping this key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Native Google Maps SDK keys, injected into app.json at build time.
EXPO_PUBLIC_IOS_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_KEY=

# Optional error reporting DSN (wired via src/services/telemetry.js).
EXPO_PUBLIC_SENTRY_DSN=
