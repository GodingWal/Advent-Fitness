# Backend API base URL. Must be https:// outside dev/localhost.
EXPO_PUBLIC_API_URL=https://api.adventfitness.app/

# Google Places API key (used in src/services/places.js)
# Prefer proxying via EXPO_PUBLIC_API_URL/places/nearby to avoid shipping this key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Native Google Maps SDK keys, injected into app.json at build time.
EXPO_PUBLIC_IOS_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_KEY=

# Optional error reporting DSN (wired via src/services/telemetry.js).
EXPO_PUBLIC_SENTRY_DSN=
