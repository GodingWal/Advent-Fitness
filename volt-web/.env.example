# volt-web env
# Public base URL of volt-api (browser + server proxy fallback).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-only override (Vercel / production). Falls back to NEXT_PUBLIC_API_URL.
VOLT_API_URL=
# Cookie secret is not needed: session is opaque tokens proxied from volt-api.
# CSRF: route handlers check Origin/Referer on POST/PUT/DELETE (same-origin).
